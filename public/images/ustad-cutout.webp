<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 480" fill="none">
  <!-- Respectful Scholar Silhouette Placeholder (No face details) -->
  <g opacity="0.9">
    <!-- Scholar Turban / Headdress -->
    <path d="M150 110C150 70 180 50 200 50C220 50 250 70 250 110C240 120 210 125 200 125C190 125 160 120 150 110Z" fill="#F4F2EC"/>
    <path d="M140 100C160 85 240 85 260 100C250 115 150 115 140 100Z" fill="#E2DFC8"/>
    <!-- Head Contour -->
    <ellipse cx="200" cy="130" rx="38" ry="42" fill="#EBD9C0"/>
    <!-- Traditional White Shawl / Cloak -->
    <path d="M110 240C110 180 150 170 200 170C250 170 290 180 290 240L320 480H80L110 240Z" fill="#F4F2EC"/>
    <!-- Shawl Fold Details -->
    <path d="M160 175C170 230 175 320 170 480" stroke="#DDD9CE" stroke-width="4"/>
    <path d="M240 175C230 230 225 320 230 480" stroke="#DDD9CE" stroke-width="4"/>
    <!-- Scholar Gold Edge / Trim -->
    <path d="M190 180L200 360L210 180" stroke="#FFC93C" stroke-width="3"/>
  </g>
  <!-- Label badge -->
  <rect x="120" y="420" width="160" height="34" rx="17" fill="#1E1F22" stroke="#FFC93C" stroke-width="2"/>
  <text x="200" y="442" fill="#FFC93C" font-family="sans-serif" font-size="13" font-weight="bold" text-anchor="middle">Ustad Photo Placeholder</text>
</svg>
